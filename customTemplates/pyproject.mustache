[project]
name = "{{projectName}}"
version = "{{packageVersion}}"
description = "{{appName}}"
requires-python = ">3.6"
dependencies = [
  "urllib3 (>=1.25.3)",
  "python-dateutil",
{{#asyncio}}
  "aiohttp (>=3.0.0)",
{{/asyncio}}
{{#tornado}}
  "tornado (>=4.2,<5)",
{{/tornado}}
{{#hasHttpSignatureMethods}}
  "pem (>=19.3.0)",
  "pycryptodome (>=3.9.0)",
{{/hasHttpSignatureMethods}}
]

[build-system]
requires = ["poetry-core>=2.0.0,<3.0.0"]
build-backend = "poetry.core.masonry.api"

[tool.poetry]
packages = [
    {include = "{{packageName}}"}
]

